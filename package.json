{
  "name": "ferrum-tester",
  "version": "0.2.0",
  "description": "Agent-native browser, extension, web, WebDriver, Electron, process and Appium test workbench.",
  "type": "module",
  "main": "src/desktop/main.cjs",
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "ferrum": "./bin/ferrum.mjs"
  },
  "scripts": {
    "start": "node ./bin/ferrum.mjs dashboard",
    "desktop": "electron ./src/desktop/main.cjs",
    "doctor": "node ./bin/ferrum.mjs doctor",
    "test": "node --test tests/*.test.mjs",
    "smoke:extension": "node ./bin/ferrum.mjs test ./examples/self-test-extension.json --headless",
    "smoke:web": "node ./bin/ferrum.mjs test ./examples/self-test-web.json --headless",
    "smoke:network": "node ./scripts/network-offline-smoke.mjs",
    "smoke:service-fixture": "node ./scripts/disposable-service-smoke.mjs",
    "smoke:api-stateful": "node ./scripts/api-stateful-smoke.mjs",
    "smoke:service-network-fault": "node ./scripts/service-network-fault-smoke.mjs",
    "smoke:webdriver": "bash ./scripts/selenium-grid-smoke.sh",
    "smoke:github-wiki": "node ./scripts/github-wiki-bootstrap-smoke.mjs",
    "smoke:mcp-inspector": "node ./scripts/mcp-inspector-smoke.mjs",
    "smoke:electron": "node ./bin/ferrum.mjs test ./examples/self-test-electron.json --compact",
    "smoke:desktop": "node ./bin/ferrum.mjs test ./examples/self-test-desktop.json --compact",
    "package:desktop": "electron-packager . Ferrum --out=dist --overwrite --prune=true --ignore=^/artifacts --ignore=^/dist --ignore=^/.git --ignore=^/.agents-memory",
    "smoke:packaged-desktop": "node ./scripts/packaged-desktop-smoke.mjs",
    "ci": "npm test && npm run smoke:web && npm run smoke:extension && npm run smoke:dashboard",
    "smoke:lightpanda": "node ./scripts/lightpanda-smoke.mjs",
    "smoke:dashboard": "node ./scripts/dashboard-smoke.mjs"
  },
  "dependencies": {
    "playwright": "1.63.0-alpha-2026-08-17"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "electron": "43.4.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Herbertofury/Ferrum-Browser.git"
  }
}
