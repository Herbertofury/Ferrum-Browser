{
  "version": 1,
  "name": "ferrum-self-test-webdriver",
  "target": {
    "type": "webdriver",
    "server": "${ENV:FERRUM_WEBDRIVER_URL}",
    "capabilities": {
      "browserName": "chrome"
    }
  },
  "timeouts": {
    "startupMs": 60000,
    "stepMs": 15000
  },
  "steps": [
    {
      "action": "navigate",
      "url": "data:text/html;base64,"
    },
    {
      "action": "find",
      "using": "css selector",
      "value": "#name",
      "as": "name"
    },
    {
      "action": "fill",
      "element": "name",
      "text": "Ferrum"
    },
    {
      "action": "find",
      "using": "css selector",
      "value": "#go",
      "as": "go"
    },
    {
      "action": "click",
      "element": "go"
    },
    {
      "action": "assert-text",
      "using": "css selector",
      "value": "#out",
      "text": "hello Ferrum"
    },
    {
      "action": "find-all",
      "using": "css selector",
      "value": "button",
      "min": 1,
      "max": 1
    },
    {
      "action": "assert-visible",
      "using": "css selector",
      "value": "#late"
    },
    {
      "action": "assert-visible",
      "element": "go"
    },
    {
      "action": "title"
    },
    {
      "action": "screenshot",
      "name": "webdriver-grid"
    },
    {
      "action": "source",
      "name": "webdriver-grid"
    },
    {
      "action": "assert-session"
    }
  ]
}
