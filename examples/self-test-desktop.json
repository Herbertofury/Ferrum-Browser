{
  "version": 1,
  "name": "ferrum-self-test-desktop",
  "target": {
    "type": "electron",
    "args": ["./src/desktop/main.cjs"],
    "env": { "FERRUM_ARTIFACTS_ROOT": "artifacts/desktop-inner" }
  },
  "timeouts": { "startupMs": 30000, "stepMs": 20000 },
  "steps": [
    { "action": "wait", "selector": "#doctor", "state": "visible" },
    { "action": "click", "selector": "#doctor" },
    { "action": "wait", "ms": 400 },
    { "action": "assert-text", "selector": "#doctorOut", "text": "\"ferrum\": \"0.2.0\"" },
    { "action": "fill", "selector": "#spec", "value": "examples/process-app.json" },
    { "action": "click", "selector": "#headless" },
    { "action": "click", "selector": "#run" },
    { "action": "wait", "selector": "#runs .passed", "state": "visible", "timeoutMs": 15000 },
    { "action": "wait", "selector": "#evidence .evidence-run", "state": "visible", "timeoutMs": 15000 },
    { "action": "click", "selector": "#evidence .evidence-run" },
    { "action": "wait", "selector": "#replay .event", "state": "visible", "timeoutMs": 10000 },
    { "action": "assert-text", "selector": "#replay", "text": "step-start" },
    { "action": "screenshot", "name": "desktop-workbench" },
    { "action": "assert-console-clean" }
  ]
}
